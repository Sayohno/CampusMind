# static = offline deterministic demo; real = call a real model
LLM_MODE=static

# Fill this only in your local .env file.
# Never commit a real API key.
LLM_API_KEY=

# DeepSeek OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2

CAMPUSMIND_DEMO_MESSAGE=秋招怎么准备？